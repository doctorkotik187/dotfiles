# vim: set ft=toml :
# Tool: starship (https://starship.rs/) — Fast, customizable cross-shell prompt

"$schema" = 'https://starship.rs/config-schema.json'

format = """
$username\
$hostname\
$directory\
$git_branch\
$git_status\
$mise
[λ](bold magenta) """

[username]
show_always = true
format = "[󰄛 $user](bold magenta) "

[hostname]
ssh_only = false
format = "[at](dimmed) [$hostname](bold yellow) "

[directory]
truncation_length = 3
truncation_symbol = "…/"
format = "[in](dimmed) [$path](bold blue) "
[git_branch]
symbol = " "
format = "[$symbol$branch](bold cyan) "

[git_status]
format = '([$all_status$ahead_behind]($style) )'
style = "bold red"

[mise]
symbol = "󰭼 "
format = "[$symbol$health](bold magenta) "

# THEME & VISUALS ##################################################
palette = "{{ vars.theme }}"

[palettes.rose-pine]
red = '#eb6f92'
yellow = '#f6c177'
green = '#ebbcba'
blue = '#31748f'
cyan = '#9ccfd8'
magenta = '#c4a7e7'

[palettes.green]
red = '#ff3333'
yellow = '#ffff33'
green = '#00ff00'
blue = '#33ff33'
cyan = '#00ddaa'
magenta = '#00aa00'
