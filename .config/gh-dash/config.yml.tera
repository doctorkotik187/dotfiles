# vim: set ft=yaml :
# Tool: gh-dash (https://github.com/dlvhdr/gh-dash) — CLI dashboard for GitHub PRs and issues

# THEME & VISUALS ##################################################
{% if vars.theme == "green" %}
theme:
  colors:
    text:
      primary: "#00ff00"
      secondary: "#00aa00"
      inverted: "#001100"
      faint: "#005500"
      warning: "#ff3333"
      success: "#33ff33"
      actor: "#00ffaa"
    background:
      selected: "#002200"
    border:
      primary: "#00ff00"
      secondary: "#005500"
      faint: "#002200"
{% elif vars.theme == "rose-pine" %}
theme:
  colors:
    text:
      primary: "#e0def4"
      secondary: "#908caa"
      inverted: "#191724"
      faint: "#6e6a86"
      warning: "#eb6f92"
      success: "#31748f"
      actor: "#c4a7e7"
    background:
      selected: "#26233a"
    border:
      primary: "#ebbcba"
      secondary: "#403d52"
      faint: "#26233a"
{% endif %}
