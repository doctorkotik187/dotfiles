# vim: set ft=yaml :
# Tool: gh-dash (https://github.com/dlvhdr/gh-dash) — CLI dashboard for GitHub PRs and issues

# THEME & VISUALS ##################################################
{% if vars.theme == "gruvbox" %}
theme:
  colors:
    text:
      primary: "#ebdbb2"
      secondary: "#a89984"
      inverted: "#282828"
      faint: "#7c6f64"
      warning: "#cc241d"
      success: "#98971a"
      actor: "#d79921"
    background:
      selected: "#3c3836"
    border:
      primary: "#d79921"
      secondary: "#504945"
      faint: "#3c3836"
{% elif vars.theme == "kanagawa" %}
theme:
  colors:
    text:
      primary: "#dcd7ba"
      secondary: "#727169"
      inverted: "#1f1f28"
      faint: "#54546d"
      warning: "#c34043"
      success: "#76946a"
      actor: "#7e9cd8"
    background:
      selected: "#2d4f67"
    border:
      primary: "#7e9cd8"
      secondary: "#727169"
      faint: "#2d4f67"
{% elif vars.theme == "dark-terminal" %}
theme:
  colors:
    text:
      primary: "#00ff00"
      secondary: "#00aa00"
      inverted: "#001100"
      faint: "#005500"
      warning: "#ff3333"
      success: "#33ff33"
      actor: "#00ffaa"
    background:
      selected: "#002200"
    border:
      primary: "#00ff00"
      secondary: "#005500"
      faint: "#002200"
{% else %}
theme:
  colors:
    text:
      primary: "#e0def4"
      secondary: "#908caa"
      inverted: "#191724"
      faint: "#6e6a86"
      warning: "#eb6f92"
      success: "#31748f"
      actor: "#c4a7e7"
    background:
      selected: "#26233a"
    border:
      primary: "#ebbcba"
      secondary: "#403d52"
      faint: "#26233a"
{% endif %}
