{
  "app:ctrlvpaste": true,
  "app:disablectrlshiftdisplay": true,
  "app:hideaibutton": true,
  "app:showoverlayblocknums": false,
  "autoupdate:channel": "latest",
  "autoupdate:enabled": false,
  "telemetry:enabled": false,
  "widget:showhelp": false,
  "window:nativetitlebar": false,
  "window:reducedmotion": true,
  "conn:localhostdisplayname": "drink water",
  "term:allowbracketedpaste": true,
  "term:bellindicator": true,
  "term:bellsound": false,
  "term:cursor": "block",
  "term:cursorblink": false,
  "term:shiftenternewline": true,
  "term:fontsize": 14,
  "term:fontfamily": "{{ vars.font }}",
  "term:theme": "{% if vars.theme == 'green' %}green{% elif vars.theme == 'rose-pine' %}rosepine{% endif %}",
  "tab:background": "{% if vars.theme == 'green' %}bg@green{% elif vars.theme == 'rose-pine' %}bg@rosepine{% endif %}",
  "web:defaultsearch": "https://noai.duckduckgo.com/?q={query}",
  "web:defaulturl": "https://github.com/notifications"
}
