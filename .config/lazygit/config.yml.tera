# vim: set ft=yaml :
# Tool: lazygit (https://github.com/jesseduffield/lazygit) — Terminal UI for Git commands

git:
  diffRenderers:
    - command: delta --paging=never --syntax-theme=none
    - command: delta --paging=never --syntax-theme=none --side-by-side

gui:
  showFileTree: false
{% if vars.theme == "green" %}
  theme:
    activeBorderColor:
      - "#00ff00"
      - bold
    inactiveBorderColor:
      - "#005500"
    searchingActiveBorderColor:
      - "#33ff33"
      - bold
    optionsTextColor:
      - "#00dd00"
    selectedLineBgColor:
      - "#003300"
    inactiveViewSelectedLineBgColor:
      - "#002200"
      - bold
    cherryPickedCommitFgColor:
      - "#001100"
    cherryPickedCommitBgColor:
      - "#00ff00"
    markedBaseCommitFgColor:
      - "#001100"
    markedBaseCommitBgColor:
      - "#00cc00"
    unstagedChangesColor:
      - "#ff3333"
    defaultFgColor:
      - "#00ff00"
{% elif vars.theme == "rose-pine" %}
  theme:
    activeBorderColor:
      - "#31748f"
      - bold
    inactiveBorderColor:
      - "#6e6a86"
    searchingActiveBorderColor:
      - "#ebbcba"
      - bold
    optionsTextColor:
      - "#9ccfd8"
    selectedLineBgColor:
      - "#31748f"
    inactiveViewSelectedLineBgColor:
      - "#26233a"
      - bold
    cherryPickedCommitFgColor:
      - "#1f1d2e"
    cherryPickedCommitBgColor:
      - "#ebbcba"
    markedBaseCommitFgColor:
      - "#9ccfd8"
    markedBaseCommitBgColor:
      - "#f6c177"
    unstagedChangesColor:
      - "#eb6f92"
    defaultFgColor:
      - "#e0def4"
{% endif %}
