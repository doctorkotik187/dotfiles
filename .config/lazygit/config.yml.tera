# vim: set ft=yaml :
# Tool: lazygit (https://github.com/jesseduffield/lazygit) — Terminal UI for Git commands

git:
  diffRenderers:
    - command: delta --paging=never --syntax-theme=none
    - command: delta --paging=never --syntax-theme=none --side-by-side

gui:
  showFileTree: false
{% if vars.theme == "gruvbox" %}
  theme:
    activeBorderColor:
      - "#fe8019"
      - bold
    inactiveBorderColor:
      - "#504945"
    searchingActiveBorderColor:
      - "#fabd2f"
      - bold
    optionsTextColor:
      - "#83a598"
    selectedLineBgColor:
      - "#3c3836"
    inactiveViewSelectedLineBgColor:
      - "#282828"
      - bold
    cherryPickedCommitFgColor:
      - "#282828"
    cherryPickedCommitBgColor:
      - "#83a598"
    markedBaseCommitFgColor:
      - "#282828"
    markedBaseCommitBgColor:
      - "#fabd2f"
    unstagedChangesColor:
      - "#cc241d"
    defaultFgColor:
      - "#ebdbb2"
{% elif vars.theme == "kanagawa" %}
  theme:
    activeBorderColor:
      - "#7e9cd8"
      - bold
    inactiveBorderColor:
      - "#54546d"
    searchingActiveBorderColor:
      - "#c0a36e"
      - bold
    optionsTextColor:
      - "#7aa89f"
    selectedLineBgColor:
      - "#2d4f67"
    inactiveViewSelectedLineBgColor:
      - "#223249"
      - bold
    cherryPickedCommitFgColor:
      - "#1f1f28"
    cherryPickedCommitBgColor:
      - "#7e9cd8"
    markedBaseCommitFgColor:
      - "#1f1f28"
    markedBaseCommitBgColor:
      - "#c0a36e"
    unstagedChangesColor:
      - "#c34043"
    defaultFgColor:
      - "#dcd7ba"
{% elif vars.theme == "dark-terminal" %}
  theme:
    activeBorderColor:
      - "#00ff00"
      - bold
    inactiveBorderColor:
      - "#005500"
    searchingActiveBorderColor:
      - "#33ff33"
      - bold
    optionsTextColor:
      - "#00dd00"
    selectedLineBgColor:
      - "#003300"
    inactiveViewSelectedLineBgColor:
      - "#002200"
      - bold
    cherryPickedCommitFgColor:
      - "#001100"
    cherryPickedCommitBgColor:
      - "#00ff00"
    markedBaseCommitFgColor:
      - "#001100"
    markedBaseCommitBgColor:
      - "#00cc00"
    unstagedChangesColor:
      - "#ff3333"
    defaultFgColor:
      - "#00ff00"
{% else %}
  theme:
    activeBorderColor:
      - "#31748f"
      - bold
    inactiveBorderColor:
      - "#6e6a86"
    searchingActiveBorderColor:
      - "#ebbcba"
      - bold
    optionsTextColor:
      - "#9ccfd8"
    selectedLineBgColor:
      - "#31748f"
    inactiveViewSelectedLineBgColor:
      - "#26233a"
      - bold
    cherryPickedCommitFgColor:
      - "#1f1d2e"
    cherryPickedCommitBgColor:
      - "#ebbcba"
    markedBaseCommitFgColor:
      - "#9ccfd8"
    markedBaseCommitBgColor:
      - "#f6c177"
    unstagedChangesColor:
      - "#eb6f92"
    defaultFgColor:
      - "#e0def4"
{% endif %}
