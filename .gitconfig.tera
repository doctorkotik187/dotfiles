# vim: set ft=gitconfig :

[include]
  path = ~/.config/delta/config

[init]
  defaultBranch = main

[url "git@github.com:"]
  pushInsteadOf = "https://github.com/"

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgSign = true

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = zdiff3

[diff]
  colorMoved = default

[user]
  signingkey = ~/.ssh/git-sign.pub
  name = {{ vars.git_name }}
  email = {{ vars.email }}
