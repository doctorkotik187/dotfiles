# -- VARIABLES -----------------------------------------------------------

dk_root := env("HOME") + "/0-doctorkotik"
dk_core := dk_root + "/0-core"

dk_enc := dk_core + "/3-RESOURCES/program-data/dk.enc"
dk_mnt := env("HOME") + "/mount/dk.dec"
btrbk_dir := dk_core + "/3-RESOURCES/program-data/btrbk"
btrbk_bin := btrbk_dir + "/bin/btrbk"
kagi_enc := dk_core + "/3-RESOURCES/program-data/old-places/kagi.age"
kagi_tmp := "/dev/shm/kagi"

# -- ALWAYS CHOOSE BY DEFAULT ---------------------------------------------

[private]
default:
    @echo "Doctorkotik's justfile — available recipes:"
    @just --global-justfile --list --unsorted --list-heading ''

# -- SETUP (one-off, per machine) -----------------------------------------

[group('Setup')]
[doc('Remap keyboard to Colemak (Display Manager, TTY)')]
colemak:
    sudo localectl set-x11-keymap us pc105 colemak
    sudo localectl set-keymap us-colemak

[group('Setup')]
[doc('Prompt to drop encryption keys on disk, then lock down their permissions')]
secrets-deploy:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Deploy 'Drop on Disk' group to:"
    echo "     ~/.config/chezmoi/key.txt"
    echo "     ~/.ssh/dk-sign"
    echo "     ~/.ssh/dk-sign.pub"
    read -rp "Press Enter once done ... "
    chmod -v 600 ~/.config/chezmoi/key.txt ~/.ssh/dk-sign
    echo "Secrets deployed."

[group('Setup')]
[doc('Import an SSH key from a plugged-in Solokey/FIDO2 device')]
ssh-import-from-solokey:
    #!/usr/bin/env bash
    set -euo pipefail
    read -rp "Plug in a Solokey, then press Enter ... "
    ssh-keygen -K
    echo "SSH key imported from Solokey."

[group('Setup')]
[doc('Run the full one-off setup sequence for a freshly installed machine')]
new-machine-setup: sync-everything colemak secrets-deploy ssh-import-from-solokey
    @echo "=== NEW MACHINE SETUP COMPLETE ==="

# -- USAGE -----------------------------------------------------------------

[group('Usage')]
[doc('Decrypt kagi (via Solokey FIDO2) to a tmpfs file')]
kagi-decrypt:
    age -d -j fido2-hmac -o {{kagi_tmp}} {{kagi_enc}}

[group('Usage')]
[doc('Delete the decrypted kagi temp file')]
kagi-remove:
    rm -fv {{kagi_tmp}}

[group('Usage')]
[doc('Mount the encrypted doctorkotik vault with gocryptfs')]
gocryptfs-mount:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{dk_mnt}}
    if mountpoint -q {{dk_mnt}}; then
        echo "Already mounted at {{dk_mnt}}"
    else
        echo "Mounting {{dk_enc}} -> {{dk_mnt}}"
        gocryptfs {{dk_enc}} {{dk_mnt}}
        echo "Mounted successfully at {{dk_mnt}}"
    fi

[group('Usage')]
[doc('Unmount the encrypted doctorkotik vault')]
gocryptfs-unmount:
    fusermount -u {{dk_mnt}}

# -- UPKEEP -----------------------------------------------------------

[group('Upkeep')]
[doc('Report any unresolved Syncthing conflict files under the doctorkotik dir')]
syncthing-conflict-check:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d {{dk_root}} ]; then
        echo "{{dk_root}} doesn't exist yet, skipping conflict check."
        exit 0
    fi
    conflicts=$(fd --hidden --no-ignore --ignore-case "conflict" {{dk_root}})
    if [ -n "$conflicts" ]; then
        echo "WARNING: syncthing conflict files found:"
        echo "$conflicts"
    else
        echo "=== NO SYNCTHING CONFLICTS FOUND ==="
    fi

[group('Upkeep')]
[doc('Copy user/email/signing config from jj into global git config')]
git-import-jj-config:
    #!/usr/bin/env bash
    set -euo pipefail
    git config --global user.name "$(jj config get user.name)"
    git config --global user.email "$(jj config get user.email)"

    backend=$(jj config get signing.backend 2>/dev/null || echo "")
    case "$backend" in
        gpg)   git config --global gpg.format openpgp ;;
        gpgsm) git config --global gpg.format x509 ;;
        ssh)   git config --global gpg.format ssh ;;
        "")    echo "No jj signing backend set, skipping gpg.format" ;;
        *)     echo "Unknown jj signing backend '$backend', skipping" ;;
    esac

    if [ -n "$backend" ]; then
        git config --global user.signingkey "$(jj config get signing.key)"
        git config --global commit.gpgsign true
    fi
    echo "=== GIT CONFIG IMPORTED FROM JJ ==="

[group('Upkeep')]
[doc('Chezmoi apply, sync brew bundle & mise tools, import jj config, then check for syncthing conflicts')]
sync-everything:
    chezmoi apply
    brew bundle cleanup --global --install
    mise install
    mise prune --yes
    just --global-justfile git-import-jj-config
    just --global-justfile syncthing-conflict-check

[group('Upkeep')]
[doc('Update system (bootc/flatpak/brew via ujust), mise tools and lazyvim')]
update-everything:
    ujust update
    mise upgrade
    nvim --headless "+Lazy! sync" +qa

[group('Upkeep')]
[doc('Clean up brew, flatpak and mise')]
clean-cache:
    brew autoremove
    brew cleanup --scrub --prune=all
    flatpak uninstall --delete-data --unused -y
    mise cache prune

[group('Upkeep')]
[doc('Run the full weekly upkeep routine: sync, update, cleanup, then optionally run a btrfs scrub')]
weekly-upkeep: sync-everything update-everything clean-cache computer-btrfs-scrub
    @echo "=== WEEKLY UPKEEP COMPLETE ==="

# -- DISK MAINTENANCE -------------------------------------------------

[group('Disk Maintenance')]
[doc('Show btrfs usage and device error counters for a mount point')]
btrfs-status target='/etc':
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== btrfs filesystem usage (needs sudo to read fs metadata): {{target}} ==="
    sudo btrfs filesystem usage -T "{{target}}"
    echo ""
    echo "=== device error counters (needs sudo, root-only), should all read 0: {{target}} ==="
    sudo btrfs device stats "{{target}}"

[group('Disk Maintenance')]
[doc('Show status, then confirm and run a btrfs scrub on the root filesystem')]
computer-btrfs-scrub:
    #!/usr/bin/env bash
    set -euo pipefail
    if gum confirm --default=false "Run btrfs scrub on computer filesystem?"; then
        just --global-justfile btrfs-status
        echo ""
        echo "Starting btrfs scrub (needs sudo to write to the filesystem) ..."
        sudo -v
        sudo btrfs scrub start -B /etc
        echo "Btrfs scrub complete."
    else
        echo "Aborted."
    fi

[group('Disk Maintenance')]
[doc('Interactively pick a btrbk target drive and action, review it, and run a backup')]
btrbk-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    config=$(gum choose --header "Which drive?" \
        "full-pocketjuice" "full-microsdeeznuts" "full-whiteghost" "full-pinkbike")
    action=$(gum choose --header "run (new snapshot) or resume (reuse last snapshot)?" \
        "run" "resume")
    target=$(grep -E '^\s*target\s+' {{btrbk_dir}}/${config}.conf | awk '{print $2}' | head -1)
    echo "=== btrbk stats (needs sudo to read snapshot metadata): {{btrbk_dir}}/${config}.conf ==="
    sudo {{btrbk_bin}} -c {{btrbk_dir}}/${config}.conf stats
    echo ""
    echo "=== btrbk usage (needs sudo, same as above): {{btrbk_dir}}/${config}.conf ==="
    sudo {{btrbk_bin}} -c {{btrbk_dir}}/${config}.conf usage
    echo ""
    just --global-justfile btrfs-status "$target"
    echo ""
    if gum confirm "Run btrbk -c {{btrbk_dir}}/${config}.conf ${action}?"; then
        echo "Running btrbk $action (needs sudo to create/send btrfs snapshots) ..."
        sudo {{btrbk_bin}} -c {{btrbk_dir}}/${config}.conf "$action"
        sync
        echo "=== BACKUP COMPLETE ==="
        if gum confirm --default=false "Also run btrfs scrub on target ($target) while it's mounted?"; then
            echo "Starting btrfs scrub (needs sudo to write to the filesystem) ..."
            sudo btrfs scrub start -B "$target"
            echo "Btrfs scrub complete."
        fi
    else
        echo "Aborted."
    fi

# -- RECOVERY -------------------------------------------------------------

[group('Recovery')]
[doc('Unlock and mount a LUKS backup drive by device path, via Solokey')]
mount-backup-disk-using-solokey:
    #!/usr/bin/env bash
    set -euo pipefail
    lsblk -f
    echo ""
    read -rp "Partition to unlock (e.g. /dev/sda1): " dev
    read -rp "Name (e.g. backup1): " name
    echo "Unlocking $dev (needs sudo to open a LUKS mapping) ..."
    sudo cryptsetup open "$dev" "$name"
    echo "Creating mount point (needs sudo to write under /mnt) ..."
    sudo mkdir -p /mnt/"$name"
    echo "Mounting (needs sudo to mount filesystems) ..."
    sudo mount /dev/mapper/"$name" /mnt/"$name"
    echo "Mounted at /mnt/$name"

[group('Recovery')]
[doc('Unmount and close a previously unlocked LUKS backup drive')]
unmount-backup-disk:
    #!/usr/bin/env bash
    set -euo pipefail
    lsblk -f
    echo ""
    read -rp "Name to unmount (e.g. backup1): " name
    echo "Unmounting (needs sudo to unmount filesystems) ..."
    sudo umount /mnt/"$name"
    echo "Closing LUKS mapping (needs sudo) ..."
    sudo cryptsetup close "$name"
    echo "Unmounted and closed $name"
