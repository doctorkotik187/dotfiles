# Always choose by default ###############################

[private]
default:
    @just --global-justfile --list --unsorted

# SmolVM ##################################################

[group('SmolVM')]
[doc('Rebuild smolbaby sandbox machine from ~/.config/smolvm/Smolfile')]
smolvm-rebuild:
    #!/usr/bin/env bash
    set -euo pipefail
    gum confirm --default=false "Destroy and rebuild 'smolbaby' SmolVM machine?" || exit 0
    smolvm machine stop --name smolbaby 2>/dev/null || true
    smolvm machine delete -f --name smolbaby 2>/dev/null || true
    smolvm machine create --name smolbaby -s "$HOME/.config/smolvm/Smolfile"
    smolvm machine start --name smolbaby

# Upkeep ###################################################

[group('Upkeep')]
[doc('Update toolchains and dotfiles')]
update-tools:
    chezmoi apply
    soar update
    mise upgrade

# Local file ##############################################
import? "justfile.local"
