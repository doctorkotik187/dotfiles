# vim: set ft=toml :
# Tool: smolvm (https://github.com/smol-machines/smolvm) — MicroVM manager for lightweight Linux sandboxes

image = "registry.fedoraproject.org/fedora-toolbox:latest"
user = "dk"
workdir = "/home/dk"
net = true
cpus = 6
memory = 12288
storage = 150
block_io = "async"

[auth]
ssh_agent = true

[secrets]
AI_API_TOKEN = { from_env = "AI_API_TOKEN" }
GITHUB_TOKEN = { from_env = "BYPASS_GITHUB_TOKEN" }  # bypass github api limits

[dev]
ports = [
  "3000-3015:3000-3015",  # Next.js, Node, local stacks (covers 3000, 3001, 3002)
  "3306:3306",            # MySQL / MariaDB
  "3847:3847",            # OMP UI / internal
  "4200:4200",            # Angular
  "4321:4321",            # Astro
  "5000:5000",            # Flask / ASP.NET
  "5173-5182:5173-5182",  # Vite, SvelteKit
  "5432:5432",            # PostgreSQL
  "5554-5555:5554-5555",  # Android emulator console & ADB
  "6006:6006",            # Storybook
  "6379:6379",            # Redis
  "7234:7234",            # Keycloak IDP
  "8000-8009:8000-8009",  # Django, FastAPI
  "8080-8089:8080-8089",  # Spring Boot, Keycloak default (8080)
  "8443:8443",            # Dev HTTPS
  "8888:8888",            # Jupyter
  "9000-9001:9000-9001",  # MinIO
  "9090:9090",            # Prometheus
  "27017:27017",          # MongoDB
]
volumes = [
  "/home/dk/.local/share/chezmoi:/home/dk/.local/share/chezmoi:ro",
  "/home/dk/GIT:/home/dk/GIT"
]

init = [
  # Packages & base tools
  "dnf install -y git tig qalculate which rlwrap podman skopeo file xxd patch bind-utils traceroute rsync lsof procps-ng tree @c-development readline-devel openssl-devel libffi-devel sqlite-devel zlib-ng-compat-devel libicu-devel chezmoi zstd iproute iputils util-linux sudo hostname strace gdb socat tcpdump pv patchelf alsa-lib at-spi2-atk atk cairo libXdamage libXfixes nspr nss pango netcat iptables nftables net-tools wget curl mtr iperf3 ethtool conntrack-tools android-tools pulseaudio-libs libglvnd-glx && dnf clean all",

  # Hostname & user identity
  "ln -sf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime && echo 'smolbaby' > /etc/hostname && (hostname smolbaby 2>/dev/null || true)",
  "id -u dk >/dev/null 2>&1 || (useradd -M -s /bin/bash -u 1000 dk && echo 'dk ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dk && chown dk:dk /home/dk /home/dk/.local /home/dk/.local/share)",

  # Rootless Podman (SUID for subuids/crun; mode 0666 /dev/net/tun for pasta)
  "chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap",
  "printf '#!/bin/sh\\n[ -c /dev/net/tun ] && sudo chmod 666 /dev/net/tun 2>/dev/null || true\\n' > /etc/profile.d/99-smolvm-tun.sh && chmod +x /etc/profile.d/99-smolvm-tun.sh && sh /etc/profile.d/99-smolvm-tun.sh",

  # Network routing & SSH agent forwarding
  "printf '#!/bin/sh\\nif [ \"$(sysctl -n net.ipv4.conf.all.route_localnet 2>/dev/null)\" != \"1\" ]; then\\n    sudo sysctl -w net.ipv4.conf.all.route_localnet=1 >/dev/null 2>&1\\n    sudo nft \"add table ip nat; add chain ip nat PREROUTING { type nat hook prerouting priority dstnat; }; add rule ip nat PREROUTING dnat to 127.0.0.1\" 2>/dev/null || true\\nfi\\n' > /etc/profile.d/99-smolvm-localnet.sh && chmod +x /etc/profile.d/99-smolvm-localnet.sh && sh /etc/profile.d/99-smolvm-localnet.sh",
  "printf '#!/bin/sh\\n[ -S /tmp/ssh-agent.sock ] && sudo chown dk:dk /tmp/ssh-agent.sock 2>/dev/null || true\\n' > /etc/profile.d/99-smolvm-ssh-agent.sh && chmod +x /etc/profile.d/99-smolvm-ssh-agent.sh",

  # User dotfiles & mise toolchains
  "su - dk -c 'chezmoi init --apply && curl -fsSL https://mise.run | sh'",
]
