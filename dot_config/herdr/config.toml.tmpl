# vim: set ft=toml :
# Tool: herdr (https://herdr.dev/) — Terminal workspace manager for AI coding agents

onboarding = false

[session]
resume_agents_on_restore = false

[terminal]
default_shell       = "/bin/bash"
shell_mode          = "login"

[update]
version_check       = false

[worktrees]
directory           = "~/GIT/.wt"

[theme]
name                = "rose-pine"

[ui]
sidebar_width       = 16
status_indicators   = "symbols"
host_cursor         = "native"
prompt_new_tab_name = false
show_agent_labels_on_pane_borders = true

{{- if ne .chezmoi.hostname "smolbaby" }}
accent              = "#00F0FF"
{{- else }}
accent              = "#FF007F"
{{- end }}

[ui.toast]
delivery           = "herdr"
clipboard.position = "top-right"

[keys]
# Panes
focus_pane_up      = "alt+up"
focus_pane_down    = "alt+down"
focus_pane_left    = "alt+left"
focus_pane_right   = "alt+right"

# Tabs
previous_tab       = "alt+shift+left"
next_tab           = "alt+shift+right"
switch_tab         = "alt+1..9"
move_tab_previous  = "alt+i"
move_tab_next      = "alt+o"

# Workspaces
previous_workspace = "alt+shift+up"
next_workspace     = "alt+shift+down"

# Worktrees
open_worktree      = "prefix+shift+o"

# Agents
previous_agent     = "prefix+A"
next_agent         = "prefix+a"

# Custom Commands
[[keys.command]]
key                = "prefix+y"
type               = "shell"
command            = "herdr pane read $HERDR_ACTIVE_PANE_ID --source recent-unwrapped --lines 2000 | wl-copy"
description        = "yank pane contents to clipboard"
