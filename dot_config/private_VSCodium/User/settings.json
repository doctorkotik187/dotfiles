{
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.cursorStyle": "block",
  "editor.dragAndDrop": false,
  "editor.dropIntoEditor.enabled": false,
  "editor.fontFamily": "'CaskaydiaMono NFM', 'Adwaita Mono', 'Droid Sans Mono', 'monospace', monospace",
  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.trimWhitespaceOnDelete": true,
  "emacs-mcx.cursorMoveOnFindWidget": true,
  "files.enableTrash": false,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.discardUntrackedChangesToTrash": false,
  "git.enableSmartCommit": true,
  "search.quickOpen.includeHistory": false,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.shellIntegration.history": 0,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.tabs.title": "term${separator}${sequence}",
  "update.showReleaseNotes": false,
  "vsix.debug": true,
  "vsix.extensions": [
    "core",
    "themes",
    "markup",
    "programming"
  ],
  "vsix.groups": {
    "core": [
      "github:zokugun/vscode-vsix-manager",
      "github:zokugun/vscode-cron",
      "opn:tuttieee.emacs-mcx",
      "opn:kahole.magit"
    ],
    "markup": [
      "github:asciidoctor/asciidoctor-vscode",
      "opn:myriad-dreamin.tinymist"
    ],
    "programming": [
      "github:BetterThanTomorrow/calva"
    ],
    "themes": [
      "github:catppuccin/vscode"
    ]
  },
  "vsix.sources": {
    "opn": {
      "serviceUrl": "https://open-vsx.org/vscode/gallery",
      "type": "marketplace"
    }
  },
  "window.menuBarVisibility": "compact",
  "window.restoreWindows": "none",
  "workbench.activityBar.location": "hidden",
  "workbench.colorTheme": "Catppuccin Macchiato",
  "workbench.commandPalette.experimental.suggestCommands": true,
  "workbench.commandPalette.preserveInput": true,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 9,
  "workbench.editor.restoreViewState": false,
  "workbench.editor.showTabs": "none",
  "workbench.layoutControl.enabled": false,
  "workbench.localHistory.enabled": false,
  "workbench.startupEditor": "none",
  "files.hotExit": "off"
}
