# vim: set ft=bash :

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Source global definitions on Fedora
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

# Core ####################################################
export EDITOR="nvim"
export IGNOREEOF=9  # Ctrl+D quits only after 9 times
export COLORTERM="truecolor"

# Tools ###################################################
export PATH="$HOME/.local/share/soar/bin:$HOME/.local/bin:$PATH"
eval "$(mise activate bash)"
export STARSHIP_LOG="error"
eval "$(starship init bash)"
eval "$(zoxide init bash)"
export SMOLVM_MACHINE_NAME="smolbaby"
export BAT_THEME="ansi"
export FZF_DEFAULT_OPTS="
	--color=fg:#908caa,bg:#191724,hl:#ebbcba
	--color=fg+:#e0def4,bg+:#26233a,hl+:#ebbcba
	--color=border:#403d52,header:#31748f,gutter:#191724
	--color=spinner:#f6c177,info:#9ccfd8
	--color=pointer:#c4a7e7,marker:#eb6f92,prompt:#908caa"

# Aliases #################################################
alias nv='nvim'
alias gst='git status'
alias lg='lazygit'
alias ff='fastfetch'
alias ll='eza -al'
alias justg='just --global-justfile'
alias yt-a='yt-dlp -f 249 -x --audio-format opus --restrict-filenames'
alias kate='flatpak run org.kde.kate'
alias vm='smolvm machine start >/dev/null 2>&1; smolvm machine exec -i -t -- bash -l'

# Local file ##############################################
if [ -f "$HOME/.bashrc.local" ]; then
  . "$HOME/.bashrc.local"
fi
