(setq make-backup-files nil)
(global-auto-revert-mode 1)

(menu-bar-mode -1)
(tool-bar-mode -1)
(scroll-bar-mode -1)

(setq inhibit-startup-screen t)
(add-to-list 'initial-frame-alist '(fullscreen . maximized))

(setq ring-bell-function 'ignore)
(setq visible-bell nil)

;;; -*- lexical-binding: t -*-
